<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="ImageSortr.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <Color x:Key="AccentColor">#A60321</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentPointeroverBrush" Color="#85001A" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#650014" />
        <SolidColorBrush x:Key="AccentDisabledBrush" Color="#EFC6D0" />

        <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#85001A" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#85001A" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#650014" />
        <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#650014" />

        <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground" Color="#EFC6D0" />
        <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush" Color="#EFC6D0" />
        <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#85001A" />
        <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#85001A" />
        <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#650014" />
        <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#650014" />
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentPointeroverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPointeroverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.info">
            <Setter Property="Background" Value="#FCE9ED" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.validation">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.tag">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="TextBlock.heading-large">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="TextBlock.heading-medium">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style Selector="TextBlock.body-text">
            <Setter Property="Foreground" Value="#475569" />
        </Style>

        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
