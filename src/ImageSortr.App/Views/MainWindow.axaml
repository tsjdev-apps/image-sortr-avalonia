<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:localization="using:ImageSortr.App.Resources.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:ImageSortr.App.Models"
        xmlns:viewModels="using:ImageSortr.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="680"
        x:Class="ImageSortr.App.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Width="1120"
        Height="600"
        MinWidth="1120"
        MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        CanResize="True"
        Title="{x:Static localization:Strings.Main_WindowTitle}"
        Icon="/Assets/AppIcon.ico">

    <Grid ColumnDefinitions="1.4*,1*"
          ColumnSpacing="24"
          Margin="12">
        <Border Classes="card">
            <Grid RowDefinitions="*,Auto" RowSpacing="12">
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Classes="heading-large"
                               Text="{x:Static localization:Strings.Main_Title}" />
                    <TextBlock Classes="body-text"
                               Text="{x:Static localization:Strings.Main_Description}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="primary-text"
                               FontWeight="SemiBold"
                               Text="{x:Static localization:Strings.SourceFolder_Label}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 IsEnabled="{Binding CanEditInputs}"
                                 IsReadOnly="True"
                                 PlaceholderText="{x:Static localization:Strings.SourceFolder_Watermark}"
                                 Text="{Binding SourceFolder}" />
                        <Button Grid.Column="1"
                                Classes="Primary"
                                Command="{Binding BrowseSourceFolderCommand}"
                                IsEnabled="{Binding CanEditInputs}"
                                MinWidth="50"
                                Theme="{StaticResource SolidButton}"
                                ToolTip.Tip="{x:Static localization:Strings.SourceFolder_BrowseTooltip}">
                            <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="primary-text"
                               FontWeight="SemiBold"
                               Text="{x:Static localization:Strings.TargetFolder_Label}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Grid.Column="0"
                                 IsEnabled="{Binding CanEditInputs}"
                                 IsReadOnly="True"
                                 PlaceholderText="{x:Static localization:Strings.TargetFolder_Watermark}"
                                 Text="{Binding TargetFolder}" />
                        <Button Grid.Column="1"
                                Classes="Primary"
                                Command="{Binding BrowseTargetFolderCommand}"
                                IsEnabled="{Binding CanEditInputs}"
                                MinWidth="50"
                                Theme="{StaticResource SolidButton}"
                                ToolTip.Tip="{x:Static localization:Strings.TargetFolder_BrowseTooltip}">
                            <PathIcon Width="18" Height="18" Data="M3 6H9L11 8H21V19H3Z" />
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="primary-text"
                               FontWeight="SemiBold"
                               Text="{x:Static localization:Strings.OptionalFolderName_Label}" />
                    <TextBox IsReadOnly="{Binding IsRunning}"
                             PlaceholderText="{x:Static localization:Strings.OptionalFolderName_Watermark}"
                             Text="{Binding OptionalFolderName}" />
                </StackPanel>

                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <CheckBox IsChecked="{Binding IncludeYearInFolderName}"
                                  IsEnabled="{Binding CanEditInputs}">
                            <TextBlock Text="{x:Static localization:Strings.IncludeYear_Label}"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Classes="body-text"
                                   Text="{Binding FolderNameHint}"
                                   TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding IsOverwriteExisting}"
                                  IsEnabled="{Binding CanEditInputs}">
                            <TextBlock Text="{x:Static localization:Strings.OverwriteFiles_Label}"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Classes="body-text"
                                   Text="{x:Static localization:Strings.OverwriteFiles_Description}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="validation"
                        IsVisible="{Binding HasValidationMessage}">
                    <TextBlock Foreground="{DynamicResource ValidationTextBrush}"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap" />
                </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="1"
                        Classes="Primary"
                        Command="{Binding StartSortingCommand}"
                        Content="{Binding StartButtonText}"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        Theme="{StaticResource SolidButton}" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <TextBlock Classes="heading-medium"
                           Text="{x:Static localization:Strings.Progress_Title}" />

                <Border Grid.Row="1" Classes="info">
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10">
                        <TextBlock Classes="accent"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProgressSummary}" />
                        <TextBlock Grid.Column="1"
                                   Classes="accent"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProgressPercentageText}" />
                        <ProgressBar Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     Height="10"
                                     Foreground="{StaticResource AccentBrush}"
                                     Maximum="{Binding ProgressBarMaximum}"
                                     Value="{Binding ProcessedFileCount}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Classes="primary-text"
                               FontWeight="SemiBold"
                               Text="{x:Static localization:Strings.ProcessingHistory_Title}" />

                    <TextBlock Grid.Row="1"
                               Classes="body-text"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding HasNoProcessingHistory}"
                               Text="{x:Static localization:Strings.Progress_NoFiles}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <ListBox x:Name="ProcessingHistoryList"
                             Grid.Row="1"
                             Classes="processing-history"
                             IsVisible="{Binding HasProcessingHistory}"
                             ItemsSource="{Binding ProcessingHistory}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProcessingEntry">
                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,9">
                                    <Grid ColumnDefinitions="24,*"
                                          RowDefinitions="Auto,Auto,Auto"
                                          RowSpacing="3">
                                        <TextBlock Grid.RowSpan="3"
                                                   Classes="accent"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Text="{Binding StatusIcon}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="primary-text"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="1"
                                              Grid.Column="1"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <TextBlock Classes="body-text"
                                                       FontSize="12"
                                                       Text="{Binding StatusText}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="body-text"
                                                       FontSize="12"
                                                       IsVisible="{Binding HasDetails}"
                                                       Text="{Binding Details}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Grid.Row="2"
                                              Grid.Column="1"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="5"
                                              IsVisible="{Binding HasDestination}">
                                            <TextBlock Classes="body-text"
                                                       FontSize="12"
                                                       Text="→" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="body-text"
                                                       FontSize="12"
                                                       Text="{Binding Destination}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
