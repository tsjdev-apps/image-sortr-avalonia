<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:ImageSortr.App.Resources.Localization"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="ImageSortr.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#A60321</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentPointeroverBrush" Color="#85001A" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#650014" />
            <SolidColorBrush x:Key="AccentDisabledBrush" Color="#EFC6D0" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ButtonSolidPrimaryBackground" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground" Color="#85001A" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush" Color="#85001A" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground" Color="#650014" />
            <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush" Color="#650014" />

            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground" Color="#EFC6D0" />
            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush" Color="#EFC6D0" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#85001A" />
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#85001A" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#650014" />
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#650014" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569" />
                    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FCE9ED" />
                    <SolidColorBrush x:Key="ValidationBackgroundBrush" Color="#FEF2F2" />
                    <SolidColorBrush x:Key="ValidationBorderBrush" Color="#FCA5A5" />
                    <SolidColorBrush x:Key="ValidationTextBrush" Color="#B91C1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F2937" />
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#273449" />
                    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#475569" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#3A1620" />
                    <SolidColorBrush x:Key="ValidationBackgroundBrush" Color="#3B151B" />
                    <SolidColorBrush x:Key="ValidationBorderBrush" Color="#BE123C" />
                    <SolidColorBrush x:Key="ValidationTextBrush" Color="#FDA4AF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="{x:Static localization:LocalizationSettings.CurrentLocaleName}" />

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentPointeroverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPointeroverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="24" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Border.info">
            <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.validation">
            <Setter Property="Background" Value="{DynamicResource ValidationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ValidationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="TextBlock.heading-large">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.heading-medium">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.body-text">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.primary-text">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox.processing-history">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.processing-history ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Application.Styles>
</Application>
